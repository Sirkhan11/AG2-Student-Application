rules_version = '2';
// Deployed with the live site: npx firebase-tools deploy --only hosting,firestore:rules (see
// firebase.json), so the site and the rules always match. Check with scripts/check-uni-rules.mjs.
service cloud.firestore {
  match /databases/{database}/documents {

    // AG2 is for Northumbria students: every read and write below needs a signed-in account whose
    // Northumbria email address (ending @northumbria.ac.uk, in any case) has been verified, however
    // the account was made (src/lib/uni-email.js checks the same on the app's forms). The only
    // exception is the check scripts' test accounts, by uid (isTestAccount).
    function isNorthumbria() {
      return request.auth != null
        && ((request.auth.token.email_verified == true
              && request.auth.token.email is string
              && request.auth.token.email.lower().matches('^[^@]+@northumbria[.]ac[.]uk$'))
          || isTestAccount());
    }

    // The three accounts the check scripts sign in as (.env.test.local): two students and a
    // mentor. They hold only test data, and their passwords are long and random.
    function isTestAccount() {
      return request.auth.uid in ['Zn9BqgxGdocNVUNyzK29sCYQKSG2', 'BN5AnnatLhWw6JDgS9NmEXuXf4b2',
                                  'bzvM0WCSLRXYjSTA1dRHHhfrTro2'];
    }

    // Students can only read and change their own record. A write that leaves a checklist in it
    // (the checklist page's) must leave a valid one: see validChecklist below.
    match /students/{userId} {
      allow read, delete: if isNorthumbria() && request.auth.uid == userId;
      allow create, update: if isNorthumbria() && request.auth.uid == userId
        && (!('checklist' in request.resource.data) || validChecklist(request.resource.data.checklist));
    }

    // The public part of a mentor's profile: only what matching needs.
    // Logged-in users can only see approved mentors (mentors can always see themselves).
    // Mentors can create and edit their own, but can't approve themselves, and can't add
    // any other fields, so private details (like an email) can't end up here.
    match /mentors/{userId} {
      allow read: if isNorthumbria()
        && (resource.data.approved == true || request.auth.uid == userId);

      // A new mentor starts unapproved, with no students yet.
      allow create: if isNorthumbria() && request.auth.uid == userId
        && onlyPublicMentorFields()
        && validItemVectors(request.resource.data.itemVectors)
        && validMaxStudents()
        && request.resource.data.approved == false
        && request.resource.data.studentCount == 0;

      // The mentor editing their own profile. After an edit, approved can only be true if it
      // was true before AND nothing the coordinator checked has changed. So mentors can't
      // approve themselves, and changing their display name or item vectors sends them back
      // to the coordinator (approved: false). They can't change studentCount (only a student
      // taking a place can, below), or lower maxStudents below it.
      allow update: if isNorthumbria() && request.auth.uid == userId
        && onlyPublicMentorFields()
        && validItemVectors(request.resource.data.itemVectors)
        && validMaxStudents()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentCount'])
        && request.resource.data.maxStudents >= request.resource.data.studentCount
        && request.resource.data.approved == (resource.data.approved && !checkedFieldsChanged());

      // A student taking one of this mentor's places (see matches below). The only change
      // allowed is studentCount going up by exactly one, so every other field, including
      // approved, stays exactly as it was. The mentor must be approved and have room, the
      // student must not have a match yet, and their match to this mentor must be created
      // in the same write.
      allow update: if isNorthumbria() && request.auth.uid != userId
        && resource.data.approved == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount'])
        && request.resource.data.studentCount == resource.data.studentCount + 1
        && request.resource.data.studentCount <= resource.data.maxStudents
        && !exists(/databases/$(database)/documents/matches/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/matches/$(request.auth.uid)).data.mentorId == userId;

      allow delete: if isNorthumbria() && request.auth.uid == userId;
    }

    // The private part: name, course, availability, written answers and so on.
    // Only the mentor can read or change it. The coordinator uses the Firebase console.
    match /mentorDetails/{userId} {
      allow read, write: if isNorthumbria() && request.auth.uid == userId;
    }

    // A student's match, stored under their own uid, so each student has at most one.
    // Only that student can create or read it; the coordinator uses the console.
    // Nobody can change or delete it from the app, so a student can't swap mentors, or free
    // up a place and take another.
    // - status 'matched': the student took one of mentorId's places in the same write.
    // - status 'coordinator': no mentor yet; the coordinator will find one.
    match /matches/{studentId} {
      allow read: if isNorthumbria() && request.auth.uid == studentId;
      allow create: if isNorthumbria() && request.auth.uid == studentId
        && validMatch(request.resource.data);
    }

    // A student asking the coordinator for a different mentor, under their own uid, so each student
    // has at most one open request. Only that student can send, read and cancel (delete) it: never
    // their mentor or anyone else, and only while they have a mentor. The coordinator reads it in the
    // Firebase console and deletes it once they've moved the student. Nothing changes it from the app,
    // and the chat never reads it.
    match /mentorChangeRequests/{studentId} {
      allow read, delete: if isNorthumbria() && request.auth.uid == studentId;
      allow create: if isNorthumbria() && request.auth.uid == studentId
        && validChangeRequest(request.resource.data)
        && get(/databases/$(database)/documents/matches/$(studentId)).data.status == 'matched';
    }

    // NSU's info for each society (description, memberships, socials, contact email), copied from
    // its NSU page by scripts/import-society-pages.mjs, which uses the Admin SDK and so ignores these
    // rules. Signed-in users can read it; nobody can change it from the app.
    match /societies/{societyId} {
      allow read: if isNorthumbria();
      allow write: if false;
    }

    // Northumbria Sport's info for each sports club (about, memberships and training, contacts,
    // socials, booking link), copied from northumbriasport.com by scripts/import-sport-club-pages.mjs,
    // which uses the Admin SDK and so ignores these rules. The contacts are people's names and emails,
    // so only signed-in users can read it, and nobody can change it from the app.
    match /sportClubs/{slug} {
      allow read: if isNorthumbria();
      allow write: if false;
    }

    // A request for a different mentor: one of the reasons on the Your Mentor page (CHANGE_REASONS in
    // src/lib/matching/change-reasons.js), the student's own words (up to 500 characters, and needed
    // for "something else"), and when it was sent. Nothing else, so no other details can be stored.
    function validChangeRequest(record) {
      return record.keys().hasOnly(['reason', 'details', 'createdAt'])
        && record.reason in ['not-a-good-fit', 'times-dont-work', 'not-replying', 'uncomfortable', 'something-else']
        && record.details is string && record.details.size() <= 500
        && (record.reason != 'something-else' || record.details.size() > 0)
        && record.createdAt == request.time;
    }

    // True when the mentor document being written has no fields beyond these five.
    function onlyPublicMentorFields() {
      return request.resource.data.keys().hasOnly(
        ['displayName', 'itemVectors', 'approved', 'maxStudents', 'studentCount']);
    }

    // maxStudents must be a whole number from 1 to 5, the range on the sign-up form.
    function validMaxStudents() {
      let max = request.resource.data.maxStudents;
      return max is int && max >= 1 && max <= 5;
    }

    // itemVectors must have exactly q1 to q6, one per question. Firestore can't store a list of
    // lists, so each question holds its phrase vectors back to back in one flat list of numbers
    // (see mentors.js). Missing itemVectors fails too, so every mentor profile must have them.
    function validItemVectors(itemVectors) {
      return itemVectors is map
        && itemVectors.keys().hasAll(['q1', 'q2', 'q3', 'q4', 'q5', 'q6'])
        && itemVectors.keys().hasOnly(['q1', 'q2', 'q3', 'q4', 'q5', 'q6'])
        && wholeVectors(itemVectors.q1) && wholeVectors(itemVectors.q2)
        && wholeVectors(itemVectors.q3) && wholeVectors(itemVectors.q4)
        && wholeVectors(itemVectors.q5) && wholeVectors(itemVectors.q6);
    }

    // A whole number of 384-number vectors, and at most 5 of them (Gemini's 5-phrase cap), so
    // 0 to 1920 numbers. This enforces the cap on the server: a mentor can't store extra phrases
    // to match more students. (Rules can't loop, so each number isn't checked; the app skips
    // any profile with non-numbers when it loads mentors.)
    function wholeVectors(numbers) {
      return numbers is list && numbers.size() % 384 == 0 && numbers.size() <= 1920;
    }

    // True when an edit changes something the coordinator checked before approving.
    function checkedFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName', 'itemVectors']);
    }

    // A match has only these fields. Reading a field that's missing makes the rule fail, so
    // every field named here is also required. A 'matched' one also names the mentor (with
    // their display name, so it can still be shown if they're un-approved later) and up to
    // 3 reasons, and must take one of that mentor's places in the same write.
    function validMatch(record) {
      return record.meetingFrequency in ['weekly', 'every two weeks', 'monthly']
        && record.availability is string && record.availability.size() <= 200
        && record.createdAt == request.time
        && ((record.status == 'coordinator'
              && record.keys().hasOnly(['status', 'meetingFrequency', 'availability', 'createdAt']))
          || (record.status == 'matched'
              && record.keys().hasOnly(['status', 'mentorId', 'mentorName', 'reasons',
                                        'meetingFrequency', 'availability', 'createdAt'])
              && record.mentorName is string
              && record.reasons is list && record.reasons.size() <= 3
              && takesPlace(record.mentorId)));
    }

    // True when the mentor is approved and their studentCount goes up by exactly one in this
    // same write. The mentors rules above check the rest (room, nothing else changing).
    function takesPlace(mentorId) {
      let mentor = /databases/$(database)/documents/mentors/$(mentorId);
      return get(mentor).data.approved == true
        && getAfter(mentor).data.studentCount == get(mentor).data.studentCount + 1;
    }

    // One settling-in task: only id, title and done, with a title of at most 100 characters
    // (MAX_TITLE_LENGTH in src/lib/checklist/tasks.js). A task that isn't a map, or has no title,
    // makes the check fail, which refuses the write. Kept short, as it runs once per task.
    function validTask(task) {
      return task.keys().hasOnly(['id', 'title', 'done'])
        && task.title is string && task.title.size() <= 100
        && task.done is bool;
    }

    // At most 15 tasks (MAX_TASKS in tasks.js), each valid. Rules can't loop over a list, so each
    // of the 15 places is checked in turn; a shorter list passes the places it doesn't reach. Each
    // place costs part of the rules' per-write evaluation limit (50 places refused 20 tasks or more),
    // so keep the number of places equal to MAX_TASKS and well under that.
    function validChecklist(tasks) {
      return tasks is list && tasks.size() <= 15
        && (tasks.size() <= 0 || validTask(tasks[0]))
        && (tasks.size() <= 1 || validTask(tasks[1]))
        && (tasks.size() <= 2 || validTask(tasks[2]))
        && (tasks.size() <= 3 || validTask(tasks[3]))
        && (tasks.size() <= 4 || validTask(tasks[4]))
        && (tasks.size() <= 5 || validTask(tasks[5]))
        && (tasks.size() <= 6 || validTask(tasks[6]))
        && (tasks.size() <= 7 || validTask(tasks[7]))
        && (tasks.size() <= 8 || validTask(tasks[8]))
        && (tasks.size() <= 9 || validTask(tasks[9]))
        && (tasks.size() <= 10 || validTask(tasks[10]))
        && (tasks.size() <= 11 || validTask(tasks[11]))
        && (tasks.size() <= 12 || validTask(tasks[12]))
        && (tasks.size() <= 13 || validTask(tasks[13]))
        && (tasks.size() <= 14 || validTask(tasks[14]));
    }
  }
}
